# =============================================================================
# VaakuOS frontend — environment variables (Vite)
# Copy to `.env` and fill in. Only VITE_*-prefixed vars are exposed to the
# browser bundle — never put server secrets here.
# =============================================================================

# Base URL of the instacal-backend API. Falls back to a hardcoded Render URL in
# apiSlice.ts if unset, but set it explicitly per environment.
VITE_API_BASE_URL=http://localhost:3001

# Google OAuth client ID for Google sign-in (public by design).
VITE_GOOGLE_CLIENT_ID=

# Razorpay public key id (rzp_test_* / rzp_live_*). Required for checkout;
# the subscribe flow aborts with an error if this is unset.
VITE_RAZORPAY_KEY_ID=

# Sentry error tracking DSN (public by design). Leave empty to disable —
# the SDK stays inert without it, so local dev sends nothing.
VITE_SENTRY_DSN=
